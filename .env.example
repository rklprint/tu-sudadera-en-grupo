# Activa el envío de avisos cuando el dominio esté verificado en el proveedor de correo.
RESEND_API_KEY=
QUOTE_TO_EMAIL=pedidos@tusudaderaengrupo.es
QUOTE_FROM_EMAIL=Tu Sudadera en Grupo <web@tusudaderaengrupo.es>
ADMIN_EMAIL=admin@tusudaderaengrupo.es

# Seguridad de formularios. La clave pública es segura para el navegador; la
# secreta solo se configura en el proveedor de hosting.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Solo para la web privada actual. Debe quedar desactivado en Vercel salvo que
# exista un proxy de confianza que firme/inyecte estos encabezados.
TRUST_OPENAI_IDENTITY_HEADERS=false

# Las rutas TSG-DEMO solo deben existir en development/test. Mantener false en
# preview y production para no exponer datos ni mutaciones de demostración.
ENABLE_DEMO_ROUTES=false

# Analítica anónima/cookieless. No se activan autocapture, perfiles ni replay.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Observabilidad. SENTRY_AUTH_TOKEN solo se usa en CI para sourcemaps y nunca
# se expone al navegador.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
# Origen canónico server-only. No se acepta desde el navegador ni se deriva
# de Host/Origin/Referer. En staging debe ser una URL HTTPS estable.
APP_ORIGIN=http://localhost:3000
# Alias opcionales separados por comas; solo controlan solicitudes entrantes.
APP_ALLOWED_ORIGINS=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=

# Redsys: empezar siempre con test. No copiar claves reales al repositorio.
REDSYS_ENVIRONMENT=test
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=
REDSYS_SIGNING_KEY=
REDSYS_BIZUM_ENABLED=false

# Transferencia manual. Si falta cualquiera de estos datos, la opción no se
# ofrece y no se crea una operación incompleta.
BANK_TRANSFER_IBAN=
BANK_TRANSFER_ACCOUNT_HOLDER=
